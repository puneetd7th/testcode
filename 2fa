@RestController
@RequestMapping("/api/2fa")
public class TwoFactorController {

    private final SecureRandom secureRandom = new SecureRandom();
    private final Map<String, Challenge> challengeStore = new ConcurrentHashMap<>();

    @GetMapping("/generate")
    public ChallengeResponse generateChallenge(HttpSession session) {
        int correctCode = secureRandom.nextInt(90) + 10;

        Set<Integer> codes = new HashSet<>();
        codes.add(correctCode);
        while (codes.size() < 3) {
            codes.add(secureRandom.nextInt(90) + 10);
        }
        List<Integer> options = new ArrayList<>(codes);
        Collections.shuffle(options);

        String challengeId = UUID.randomUUID().toString();

        // Save in session or Redis
        Challenge challenge = new Challenge(challengeId, correctCode, System.currentTimeMillis() + 2 * 60 * 1000);
        challengeStore.put(challengeId, challenge);

        // Only send options to mobile
        return new ChallengeResponse(challengeId, options);
    }

    @PostMapping("/verify")
    public ResponseEntity<String> verifyCode(@RequestBody SignedResponse request) throws Exception {
        Challenge challenge = challengeStore.get(request.getChallengeId());
        if (challenge == null || challenge.expired()) {
            return ResponseEntity.status(HttpStatus.UNAUTHORIZED).body("Challenge expired or invalid");
        }

        // Signature verification
        String data = request.getChallengeId() + ":" + request.getSelectedCode();
        PublicKey publicKey = KeyLoader.loadPublicKey(); // Implement this
        boolean validSignature = RSASignatureUtil.verify(data, request.getSignature(), publicKey);

        if (!validSignature) {
            return ResponseEntity.status(HttpStatus.FORBIDDEN).body("Invalid signature");
        }

        if (request.getSelectedCode() != challenge.getCorrectCode()) {
            return ResponseEntity.status(HttpStatus.FORBIDDEN).body("Wrong code");
        }

        // Optional: Remove used challenge
        challengeStore.remove(request.getChallengeId());

        return ResponseEntity.ok("Verified");
    }
}

