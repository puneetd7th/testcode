@PostMapping("/generate-challenge")
public ResponseEntity<Map<String, Object>> generateChallenge(@RequestParam String userId) {
    SecureRandom random = new SecureRandom();

    // Generate 3 random 3-digit codes
    List<String> codes = Stream.generate(() -> String.format("%03d", random.nextInt(1000)))
                               .distinct().limit(3).collect(Collectors.toList());

    // Pick one as the correct answer
    String correctCode = codes.get(random.nextInt(3));

    String challengeId = UUID.randomUUID().toString();
    long expiresAt = System.currentTimeMillis() + (60 * 1000); // 1 min expiry
    String nonce = UUID.randomUUID().toString();

    Challenge challenge = new Challenge(challengeId, correctCode, codes, expiresAt, nonce, userId);
    challengeStore.put(challengeId, challenge);

    // Send all codes to mobile, correct one will be shown on web
    Map<String, Object> mobilePayload = Map.of(
        "challengeId", challengeId,
        "codes", codes,
        "expiresAt", expiresAt,
        "nonce", nonce
    );

    // Show only the correct code on web (not exposed to user)
    Map<String, Object> webPayload = Map.of(
        "codeToDisplay", correctCode
    );

    // Return both (simulated)
    return ResponseEntity.ok(Map.of("web", webPayload, "mobile", mobilePayload));
}
