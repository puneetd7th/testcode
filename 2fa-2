@PostMapping("/verify-response")
public ResponseEntity<String> verifyResponse(@RequestBody VerificationRequest request) throws Exception {
    Challenge challenge = challengeStore.get(request.getChallengeId());
    if (challenge == null) return ResponseEntity.status(404).body("Invalid challenge");

    if (System.currentTimeMillis() > challenge.getExpiresAt()) {
        return ResponseEntity.status(400).body("Challenge expired");
    }

    if (!challenge.getNonce().equals(request.getNonce())) {
        return ResponseEntity.status(400).body("Invalid nonce");
    }

    String payload = String.join(":",
        challenge.getChallengeId(),
        request.getSelectedCode(),
        String.valueOf(challenge.getExpiresAt()),
        challenge.getNonce()
    );

    boolean isValid = SignatureUtil.verifySignature(payload, request.getSignature(), request.getPublicKey());
    if (!isValid) return ResponseEntity.status(400).body("Invalid signature");

    if (!request.getSelectedCode().equals(challenge.getCorrectCode())) {
        return ResponseEntity.status(400).body("Wrong code");
    }

    challengeStore.remove(request.getChallengeId()); // Invalidate after use
    return ResponseEntity.ok("Success");
}
