// Secure 2FA Challenge - Stateless with RSA JWT, Nonce, and Backend-stored Correct Code with Expiry

// 1. === ChallengeController.java ===

@RestController
@RequestMapping("/api/challenge")
public class ChallengeController {

    @Autowired
    private RSAKeyProvider keyProvider;

    @Autowired
    private ChallengeStore challengeStore;

    @GetMapping("/generate")
    public ResponseEntity<Map<String, Object>> generateChallenge() {
        SecureRandom random = new SecureRandom();
        int correctCode = random.nextInt(900) + 100;
        int wrong1 = correctCode;
        int wrong2 = correctCode;
        while (wrong1 == correctCode) wrong1 = random.nextInt(900) + 100;
        while (wrong2 == correctCode || wrong2 == wrong1) wrong2 = random.nextInt(900) + 100;

        List<Integer> codes = Arrays.asList(correctCode, wrong1, wrong2);
        Collections.shuffle(codes);

        String nonce = UUID.randomUUID().toString();
        Instant expiry = Instant.now().plusSeconds(300);

        // Save correctCode mapped to nonce with expiry
        challengeStore.storeChallenge(nonce, correctCode, expiry);

        String jwt = JWT.create()
            .withClaim("nonce", nonce)
            .withExpiresAt(Date.from(expiry))
            .sign(Algorithm.RSA256(keyProvider.getPublicKey(), keyProvider.getPrivateKey()));

        Map<String, Object> response = new HashMap<>();
        response.put("codes", codes);
        response.put("token", jwt);

        return ResponseEntity.ok(response);
    }
}


// 2. === VerificationController.java ===

@RestController
@RequestMapping("/api/verify")
public class VerificationController {

    @Autowired
    private RSAKeyProvider keyProvider;

    @Autowired
    private ChallengeStore challengeStore;

    @PostMapping
    public ResponseEntity<String> verify(@RequestBody VerificationRequest request) {
        try {
            DecodedJWT jwt = JWT.require(Algorithm.RSA256(keyProvider.getPublicKey(), keyProvider.getPrivateKey()))
                    .build().verify(request.getToken());

            String nonce = jwt.getClaim("nonce").asString();
            if (nonce == null) return ResponseEntity.status(HttpStatus.BAD_REQUEST).body("Invalid token");

            // Validate signature
            Signature sig = Signature.getInstance("SHA256withRSA");
            sig.initVerify(getPublicKeyFromPEM(request.getMobilePublicKey()));
            String signedPayload = request.getToken() + ":" + request.getSelectedCode() + ":" + nonce;
            sig.update(signedPayload.getBytes(StandardCharsets.UTF_8));

            boolean isValid = sig.verify(Base64.getDecoder().decode(request.getSignature()));
            if (!isValid) return ResponseEntity.status(HttpStatus.UNAUTHORIZED).body("Invalid signature");

            ChallengeEntry entry = challengeStore.getChallenge(nonce);
            if (entry == null || entry.getExpiry().isBefore(Instant.now())) {
                challengeStore.removeChallenge(nonce);
                return ResponseEntity.status(HttpStatus.GONE).body("Challenge expired");
            }

            if (Objects.equals(entry.getCorrectCode(), request.getSelectedCode())) {
                challengeStore.removeChallenge(nonce);
                return ResponseEntity.ok("Verification successful");
            } else {
                return ResponseEntity.status(HttpStatus.FORBIDDEN).body("Incorrect code");
            }

        } catch (Exception e) {
            return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).body("Error: " + e.getMessage());
        }
    }

    private PublicKey getPublicKeyFromPEM(String pem) throws Exception {
        String cleanPem = pem.replaceAll("-----\\w+ PRIVATE KEY-----", "").replaceAll("\\s", "");
        byte[] decoded = Base64.getDecoder().decode(cleanPem);
        X509EncodedKeySpec spec = new X509EncodedKeySpec(decoded);
        KeyFactory kf = KeyFactory.getInstance("RSA");
        return kf.generatePublic(spec);
    }
}


// 3. === VerificationRequest.java ===

@Data
public class VerificationRequest {
    private String token;
    private Integer selectedCode;
    private String signature;
    private String mobilePublicKey; // PEM format
}


// 4. === RSAKeyProvider.java ===

@Component
public class RSAKeyProvider {
    private KeyPair keyPair;

    public RSAKeyProvider() throws Exception {
        KeyPairGenerator keyGen = KeyPairGenerator.getInstance("RSA");
        keyGen.initialize(2048);
        this.keyPair = keyGen.generateKeyPair();
    }

    public RSAPublicKey getPublicKey() {
        return (RSAPublicKey) keyPair.getPublic();
    }

    public RSAPrivateKey getPrivateKey() {
        return (RSAPrivateKey) keyPair.getPrivate();
    }
}


// 5. === ChallengeStore.java ===

@Component
public class ChallengeStore {
    private final Map<String, ChallengeEntry> challengeMap = new ConcurrentHashMap<>();

    public void storeChallenge(String nonce, int correctCode, Instant expiry) {
        challengeMap.put(nonce, new ChallengeEntry(correctCode, expiry));
    }

    public ChallengeEntry getChallenge(String nonce) {
        return challengeMap.get(nonce);
    }

    public void removeChallenge(String nonce) {
        challengeMap.remove(nonce);
    }
}


// 6. === ChallengeEntry.java ===

@Data
@AllArgsConstructor
public class ChallengeEntry {
    private int correctCode;
    private Instant expiry;
}


