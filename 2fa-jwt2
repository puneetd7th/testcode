Here's a complete Java mobile-side simulation that:

Calls the backend to get the challenge (/api/challenge/generate).

Parses the 3 shuffled codes and JWT.

Extracts the nonce from the JWT.

Simulates user selecting the correct code (if testing, we can assume the first is correct).

Signs the payload token:selectedCode:nonce with the mobile's private RSA key.




import com.auth0.jwt.JWT;
import com.auth0.jwt.interfaces.DecodedJWT;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.fasterxml.jackson.core.type.TypeReference;

import java.io.*;
import java.net.HttpURLConnection;
import java.net.URL;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Paths;
import java.security.*;
import java.security.spec.PKCS8EncodedKeySpec;
import java.util.*;

public class MobileChallengeClient {

    private static final ObjectMapper mapper = new ObjectMapper();

    public static void main(String[] args) throws Exception {
        // === Load keys ===
        String privateKeyPem = Files.readString(Paths.get("mobile_private_key.pem"));
        String publicKeyPem = Files.readString(Paths.get("mobile_public_key.pem"));
        PrivateKey privateKey = loadPrivateKey(privateKeyPem);

        // === Step 1: Get challenge from server ===
        Map<String, Object> challenge = fetchChallenge();
        List<Integer> codes = (List<Integer>) challenge.get("codes");
        String token = (String) challenge.get("token");

        System.out.println("Received codes: " + codes);
        System.out.println("JWT Token: " + token);

        // === Step 2: Extract nonce from JWT ===
        DecodedJWT decodedJWT = JWT.decode(token);
        String nonce = decodedJWT.getClaim("nonce").asString();

        System.out.println("Extracted nonce: " + nonce);

        // === Step 3: Simulate selecting the correct code ===
        int selectedCode = codes.get(0); // Simulate selecting the first one

        // === Step 4: Create signature ===
        String payload = token + ":" + selectedCode + ":" + nonce;
        String signature = signPayload(payload, privateKey);

        // === Step 5: Send signed verification request ===
        sendVerification(token, selectedCode, signature, publicKeyPem);
    }

    private static Map<String, Object> fetchChallenge() throws IOException {
        URL url = new URL("http://localhost:8080/api/challenge/generate");
        HttpURLConnection conn = (HttpURLConnection) url.openConnection();
        conn.setRequestMethod("GET");

        InputStream inputStream = conn.getInputStream();
        return mapper.readValue(inputStream, new TypeReference<Map<String, Object>>() {});
    }

    private static String signPayload(String data, PrivateKey privateKey) throws Exception {
        Signature sig = Signature.getInstance("SHA256withRSA");
        sig.initSign(privateKey);
        sig.update(data.getBytes(StandardCharsets.UTF_8));
        return Base64.getEncoder().encodeToString(sig.sign());
    }

    private static void sendVerification(String token, int selectedCode, String signature, String publicKeyPem) throws IOException {
        URL url = new URL("http://localhost:8080/api/verify");
        HttpURLConnection conn = (HttpURLConnection) url.openConnection();
        conn.setDoOutput(true);
        conn.setRequestMethod("POST");
        conn.setRequestProperty("Content-Type", "application/json");

        Map<String, Object> body = new HashMap<>();
        body.put("token", token);
        body.put("selectedCode", selectedCode);
        body.put("signature", signature);
        body.put("mobilePublicKey", publicKeyPem);

        String json = mapper.writeValueAsString(body);
        try (OutputStream os = conn.getOutputStream()) {
            os.write(json.getBytes(StandardCharsets.UTF_8));
        }

        int status = conn.getResponseCode();
        InputStream responseStream = (status < 400) ? conn.getInputStream() : conn.getErrorStream();
        String response = new BufferedReader(new InputStreamReader(responseStream)).lines().reduce("", (a, b) -> a + b + "\n");

        System.out.println("Server Response: " + response);
    }

    private static PrivateKey loadPrivateKey(String pem) throws Exception {
        String cleanPem = pem.replaceAll("-----\\w+ PRIVATE KEY-----", "").replaceAll("\\s", "");
        byte[] decoded = Base64.getDecoder().decode(cleanPem);
        PKCS8EncodedKeySpec spec = new PKCS8EncodedKeySpec(decoded);
        return KeyFactory.getInstance("RSA").generatePrivate(spec);
    }
}
