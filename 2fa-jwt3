import java.io.FileOutputStream;
import java.security.KeyPair;
import java.security.KeyPairGenerator;
import java.security.PrivateKey;
import java.security.PublicKey;
import java.util.Base64;

public class KeyGen {
    public static void main(String[] args) throws Exception {
        KeyPairGenerator keyGen = KeyPairGenerator.getInstance("RSA");
        keyGen.initialize(2048);
        KeyPair pair = keyGen.generateKeyPair();

        try (FileOutputStream pubOut = new FileOutputStream("publicKey.pem");
             FileOutputStream privOut = new FileOutputStream("privateKey.pem")) {
            pubOut.write(Base64.getEncoder().encode(pair.getPublic().getEncoded()));
            privOut.write(Base64.getEncoder().encode(pair.getPrivate().getEncoded()));
        }

        System.out.println("Keys saved to disk.");
    }
}
