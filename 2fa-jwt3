== Key Generation ==
Client -> JWTClient : Generate RSA key pair
JWTClient -> JWKS : Publish public key in JWKS format

== JWT Creation ==
Client -> JWTClient : Create signed JWT (username, expiration)
JWTClient -> JWTClient : Sign JWT with private key\nInclude 'kid' in header
JWTClient -> Client : Return signed JWT

== JWT Validation ==
Client -> Server : Send JWT

alt JWKS in cache AND not expired
Server -> Cache : Retrieve public key by 'kid'
else JWKS expired or missing
Server -> JWKS : Fetch JWKS (HTTPS)
Server -> Cache : Store keys (expires in 1 day)
end

Server -> Server : Validate signature using public key
Server -> Server : Check expiration
Server -> Server : Extract username
Server -> Client : Respond with "Valid JWT, username: alice"

