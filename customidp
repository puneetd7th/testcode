import org.opensaml.saml.saml2.core.Assertion;
import org.springframework.web.bind.annotation.*;

@RestController
@RequestMapping("/sp")
public class SPController {

    @PostMapping("/validate")
    public String validateSAMLAssertion(@RequestBody String encryptedSAML) throws Exception {
        OpenSamlInitializer.initialize();

        // Decrypt and Verify
        Assertion assertion = SamlProcessor.decryptAndVerify(encryptedSAML);

        return "Custom Parameter: " + extractCustomParameter(assertion);
    }

    private String extractCustomParameter(Assertion assertion) {
        for (AttributeStatement attributeStatement : assertion.getAttributeStatements()) {
            for (Attribute attribute : attributeStatement.getAttributes()) {
                if ("CustomParam".equals(attribute.getName())) {
                    return attribute.getAttributeValues().get(0).getDOM().getTextContent();
                }
            }
        }
        return "Not Found";
    }
}
