        // Configure Encryption Parameters
        DataEncryptionParameters dataEncParams = new DataEncryptionParameters();
        dataEncParams.setAlgorithm(EncryptionConstants.ALGO_ID_BLOCKCIPHER_AES256);
        
        KeyEncryptionParameters keyEncParams = new KeyEncryptionParameters();
        keyEncParams.setAlgorithm(EncryptionConstants.ALGO_ID_KEYTRANSPORT_RSAOAEP);
        keyEncParams.setCredential(encryptionCredential);
        keyEncParams.setKeyInfoGenerator(new StaticKeyInfoGenerator(encryptionCredential));

        // Encrypt Assertion
        Encrypter encrypter = new Encrypter(dataEncParams, keyEncParams);
        return encrypter.encrypt(assertion);
    }

    public static Assertion decryptAssertion(EncryptedAssertion encryptedAssertion, PrivateKey decryptionKey) throws DecryptionException {
        BasicCredential decryptionCredential = new BasicCredential(null, decryptionKey);
        
        Decrypter decrypter = new Decrypter(null, new StaticKeyInfoGenerator(decryptionCredential), null);
        return (Assertion) decrypter.decryptData(encryptedAssertion);
    }
}
