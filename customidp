import org.opensaml.core.xml.io.MarshallingException;
import org.opensaml.core.xml.util.XMLObjectSupport;
import org.opensaml.saml.saml2.core.Assertion;
import org.opensaml.security.credential.BasicCredential;
import org.opensaml.xmlsec.encryption.support.*;
import org.opensaml.xmlsec.keyinfo.impl.StaticKeyInfoGenerator;
import org.opensaml.xmlsec.signature.support.SignatureConstants;
import org.w3c.dom.Element;

import javax.xml.crypto.dsig.XMLSignatureException;
import java.security.KeyFactory;
import java.security.PrivateKey;
import java.security.PublicKey;
import java.security.spec.PKCS8EncodedKeySpec;
import java.util.Base64;

public class SamlProcessor {

    private static final String PRIVATE_KEY_PATH = "private_key.pem";
    private static final String PUBLIC_KEY_PATH = "public_key.pem";

    public static String signAndEncrypt(Assertion assertion) throws Exception {
        // Load private key for signing
        PrivateKey privateKey = KeyLoader.loadPrivateKey(PRIVATE_KEY_PATH);
        BasicCredential signingCredential = new BasicCredential(KeyLoader.loadPublicKey(PUBLIC_KEY_PATH), privateKey);

        // Sign Assertion
        SamlSigner.signAssertion(assertion, signingCredential, SignatureConstants.ALGO_ID_SIGNATURE_RSA_SHA256);

        // Encrypt Assertion
        PublicKey encryptionKey = KeyLoader.loadPublicKey(PUBLIC_KEY_PATH);
        Assertion encryptedAssertion = SamlEncrypter.encryptAssertion(assertion, encryptionKey);

        // Convert to String
        Element element = XMLObjectSupport.marshall(encryptedAssertion);
        return Base64.getEncoder().encodeToString(XMLObjectSupport.nodeToString(element).getBytes());
    }

    public static Assertion decryptAndVerify(String encryptedSAML) throws Exception {
        // Decode and parse XML
        byte[] decodedBytes = Base64.getDecoder().decode(encryptedSAML);
        Element element = XMLObjectSupport.unmarshallFromReader(new String(decodedBytes));

        // Decrypt
        PrivateKey decryptionKey = KeyLoader.loadPrivateKey(PRIVATE_KEY_PATH);
        Assertion decryptedAssertion = SamlEncrypter.decryptAssertion(element, decryptionKey);

        // Verify Signature
        if (!SamlSigner.verifySignature(decryptedAssertion)) {
            throw new XMLSignatureException("Signature verification failed");
        }

        return decryptedAssertion;
    }
}
