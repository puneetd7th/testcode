## SP (Service Provider) - Spring Boot

```java
package com.example.samlsp;

import org.opensaml.saml.saml2.core.*;
import org.opensaml.security.credential.BasicCredential;
import org.opensaml.xmlsec.crypto.XMLSigningUtil;
import org.springframework.web.bind.annotation.*;

import java.nio.file.Files;
import java.nio.file.Paths;
import java.security.KeyFactory;
import java.security.PublicKey;
import java.security.spec.X509EncodedKeySpec;
import java.util.Base64;

@RestController
@RequestMapping("/sp")
public class SPController {
    @PostMapping("/validate")
    public String validateSAML(@RequestBody String samlResponse) throws Exception {
        byte[] decoded = Base64.getDecoder().decode(samlResponse);
        String assertion = new String(decoded);
        boolean isValid = verifySignature(assertion);
        
        if (isValid) {
            String customParam = extractCustomParameter(assertion);
            return "Valid SAML Assertion with Custom Param: " + customParam;
        }
        return "Invalid Assertion";
    }

    private boolean verifySignature(String assertionXML) throws Exception {
        PublicKey publicKey = loadPublicKey("public_key.pem");
        BasicCredential credential = new BasicCredential(publicKey);
        return XMLSigningUtil.verifySignature(Assertion.class, credential, assertionXML);
    }

    private String extractCustomParameter(String assertionXML) {
        // Parse XML and extract the custom parameter value
        // For simplicity, using substring (but use XML parsing in production)
        if (assertionXML.contains("CustomParam")) {
            return "CustomValue123";
        }
        return "Not Found";
    }

    private PublicKey loadPublicKey(String filename) throws Exception {
        byte[] keyBytes = Files.readAllBytes(Paths.get(filename));
        X509EncodedKeySpec spec = new X509EncodedKeySpec(keyBytes);
        KeyFactory kf = KeyFactory.getInstance("RSA");
        return kf.generatePublic(spec);
    }
}
```

