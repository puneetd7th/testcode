@startuml
!includeurl https://raw.githubusercontent.com/awslabs/aws-icons-for-plantuml/v15.0/Lambda/Lambda.puml
!includeurl https://raw.githubusercontent.com/awslabs/aws-icons-for-plantuml/v15.0/EventBridge/EventBridge.puml
!includeurl https://raw.githubusercontent.com/awslabs/aws-icons-for-plantuml/v15.0/KMS/KMS.puml
!includeurl https://raw.githubusercontent.com/awslabs/aws-icons-for-plantuml/v15.0/S3/S3.puml
!includeurl https://raw.githubusercontent.com/awslabs/aws-icons-for-plantuml/v15.0/General/User.puml

' Define your custom components
!define CKMSAPI() rectangle "CKMSAPI" as CKMSAPI

title AWS Certificate Key Rotation Flow

autonumber

AWSGeneralUser(EventBridge, "EventBridge")
AWSLambda(Lambda, "Key-Rotation-Lambda")
AWSKMS(KMS, "AWS KMS")
AWSS3(S3, "S3 Bucket")
CKMSAPI()

EventBridge -> Lambda : Trigger every 330 days\n(customerId, keyAlgorithm)
Lambda -> KMS : Generate RSA Key Pair
Lambda -> Lambda : Create CSR file (CN includes customerId)
Lambda -> CKMSAPI : Check if certificate exists

alt Certificate doesn't exist
    Lambda -> CKMSAPI : Add new certificate (CSR)
else Certificate exists
    Lambda -> CKMSAPI : Renew certificate (CSR)
end

Lambda -> CKMSAPI : Fetch latest certificate info
Lambda -> S3 : Save certificate details

@enduml
