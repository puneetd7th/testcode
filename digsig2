@startuml
actor ClientApp
participant "Login-UI" as UI
participant "Authentication Service" as Auth
participant "Key Service" as KeyService
participant "Cryptography Service" as CryptoService
participant "RSA / Token Validator" as RSA
database DB

'--------------------
' Initialization Flow
'--------------------
ClientApp -> UI : init(sessionId)
UI -> Auth : create request
Auth -> Auth : generate requestId & nonce
Auth -> KeyService : get server public key
Auth -> CryptoService : get password encryption public key
Auth -> DB : store request(requestId, nonce, sessionId, status=INIT)
DB --> Auth : ok
Auth --> UI : requestId, nonce, serverPublicKey, passwordPublicKey
UI --> ClientApp : render Digital Signature UI + js sign function

ClientApp --> ClientApp : user enters credentials and clicks submit
ClientApp --> ClientApp : js sign(payload, credentials) function executes

'--------------------
' Client-Side Signing & Hybrid Encryption
'--------------------
note right of ClientApp
  Client generates ephemeral key pair per transaction
  Client signs payload + nonce with ephemeral private key
  Client encrypts password using passwordPublicKey (from Cryptography Service)
  Client generates symmetric AES key
  Client encrypts payload + signature + ephemeral public key + encrypted password using AES
  Client encrypts AES key with server public key (from KeyService)
end note
ClientApp -> UI : send encryptedPayload + encryptedSymKey + requestId
UI -> Auth : forward encryptedPayload + encryptedSymKey + requestId

'--------------------
' Validation Flow (Nonce + Credential + Signature)
'--------------------
Auth -> KeyService : decrypt encryptedSymKey with server private key
Auth -> Auth : decrypt encryptedPayload using AES key
Auth -> Auth : extract payload, signature, ephemeral public key, encrypted password
Auth -> Auth : validate nonce against DB (match & not expired/used)
alt nonce invalid
    Auth --> UI : INVALID_NONCE
    UI --> ClientApp : INVALID_NONCE
else nonce valid
    Auth -> CryptoService : validate password
    Auth -> RSA : validate token
    RSA --> Auth : credentials valid / invalid
    alt credentials invalid
        Auth --> UI : INVALID_CREDENTIALS
        UI --> ClientApp : INVALID_CREDENTIALS
    else credentials valid
        Auth -> Auth : verify signature using ephemeral public key
        alt signature valid
            Auth -> DB : update status=SIGNED
            DB --> Auth : ok
            Auth --> UI : VALID
            UI --> ClientApp : VALID
        else signature invalid
            Auth --> UI : INVALID_SIGNATURE
            UI --> ClientApp : INVALID_SIGNATURE
        end
    end
end

'--------------------
' Audit & Logging
'--------------------
note right of Auth
  Log requestId, sessionId, timestamp, userId, verification result
  Nonce prevents replay
  Status transitions: INIT -> SIGNED -> USED
end note

@enduml
