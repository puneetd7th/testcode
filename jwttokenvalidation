package com.example.jwtvalidator.service;

import com.nimbusds.jose.jwk.*;
import org.springframework.cache.annotation.Cacheable;
import org.springframework.stereotype.Service;
import org.springframework.web.client.RestTemplate;

@Service
public class JwksService {

    private static final String JWKS_URL = "https://your-domain.com/.well-known/jwks.json";

    @Cacheable(value = "jwksCache")
    public RSAKey getPublicKey() throws Exception {
        RestTemplate restTemplate = new RestTemplate();
        String jwksJson = restTemplate.getForObject(JWKS_URL, String.class);
        JWKSet jwkSet = JWKSet.parse(jwksJson);

        if (jwkSet.getKeys().isEmpty()) {
            throw new IllegalArgumentException("No keys found in JWKS");
        }

        JWK jwk = jwkSet.getKeys().get(0);
        if (!(jwk instanceof RSAKey)) {
            throw new IllegalArgumentException("Key is not RSA");
        }

        return (RSAKey) jwk;
    }
}
