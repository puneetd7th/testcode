Step 2: Configure SAML in application.yml
Modify src/main/resources/application.yml:

yaml
Copy
Edit
spring:
  security:
    saml2:
      relyingparty:
        registration:
          pingidp:
            identityprovider:
              entity-id: "https://pingidp.com/idp"
              verification.credentials:
                - certificate-location: "classpath:pingidp-public-cert.pem"
              single-sign-on-service.location: "https://pingidp.com/idp/sso"
              single-logout-service.location: "https://pingidp.com/idp/slo"
            assertingparty:
              entity-id: "http://localhost:8080/saml2/service-provider-metadata"
              signing.credentials:
                - private-key-location: "classpath:sp-private-key.pem"
                  certificate-location: "classpath:sp-public-cert.pem"
Step 3: Configure Security (Java Config)
Create SecurityConfig.java:

java
Copy
Edit
package com.example.saml;

import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.security.config.annotation.web.builders.HttpSecurity;
import org.springframework.security.saml2.provider.service.authentication.Saml2AuthenticationToken;
import org.springframework.security.web.SecurityFilterChain;

@Configuration
public class SecurityConfig {

    @Bean
    public SecurityFilterChain securityFilterChain(HttpSecurity http) throws Exception {
        http
            .authorizeHttpRequests(authorize -> authorize
                .anyRequest().authenticated()
            )
            .saml2Login()
            .saml2Logout();
        return http.build();
    }
}
Step 4: Generate SP Metadata
To get the SP metadata, run the application and visit:
➡️ http://localhost:8080/saml2/service-provider-metadata

Copy this metadata and upload it to Ping Identity.

Step 5: Create Controller to Display Assertion Data
Create SAMLController.java:

java
Copy
Edit
package com.example.saml;

import org.springframework.security.core.annotation.AuthenticationPrincipal;
import org.springframework.security.saml2.provider.service.authentication.Saml2AuthenticatedPrincipal;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RestController;

import java.util.Map;

@RestController
public class SAMLController {

    @GetMapping("/user")
    public Map<String, Object> userDetails(@AuthenticationPrincipal Saml2AuthenticatedPrincipal principal) {
        return principal.getAttributes();
    }
}
Step 6: Create Logout Controller
Create LogoutController.java:

java
Copy
Edit
package com.example.saml;

import org.springframework.security.web.authentication.logout.SecurityContextLogoutHandler;
import org.springframework.stereotype.Controller;
import org.springframework.web.bind.annotation.GetMapping;

import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;

@Controller
public class LogoutController {

    @GetMapping("/logout")
    public String logout(HttpServletRequest request, HttpServletResponse response) {
        new SecurityContextLogoutHandler().logout(request, response, null);
        return "redirect:/";
    }
}
