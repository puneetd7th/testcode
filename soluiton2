import org.opensaml.security.x509.BasicX509Credential;
import org.opensaml.xmlsec.signature.support.SignatureValidator;
import org.springframework.core.io.ClassPathResource;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RestController;

import javax.annotation.PostConstruct;
import java.io.InputStream;
import java.nio.charset.StandardCharsets;
import java.security.KeyFactory;
import java.security.PrivateKey;
import java.security.PublicKey;
import java.security.spec.PKCS8EncodedKeySpec;
import java.security.spec.X509EncodedKeySpec;

@RestController
public class SamlSpController {

    private Credential decryptionCredential;
    private PublicKey idpPublicKey;

    @PostConstruct
    public void init() throws Exception {
        InitializationService.initialize();

        // Load SP private key for decryption
        InputStream privateKeyStream = new ClassPathResource("keys/sp_private_key.pem").getInputStream();
        String privateKeyPem = new String(privateKeyStream.readAllBytes(), StandardCharsets.UTF_8)
                .replace("-----BEGIN RSA PRIVATE KEY-----", "")
                .replace("-----END RSA PRIVATE KEY-----", "")
                .replaceAll("\\s", "");
        byte[] privateKeyBytes = Base64.decodeBase64(privateKeyPem);
        PKCS8EncodedKeySpec keySpec = new PKCS8EncodedKeySpec(privateKeyBytes);
        PrivateKey privateKey = KeyFactory.getInstance("RSA").generatePrivate(keySpec);
        decryptionCredential = new BasicX509Credential(null);
        decryptionCredential.setPrivateKey(privateKey);

        // Load IdP public key for signature validation
        InputStream publicKeyStream = new ClassPathResource("keys/idp_public_key.pem").getInputStream();
        String publicKeyPem = new String(publicKeyStream.readAllBytes(), StandardCharsets.UTF_8)
                .replace("-----BEGIN PUBLIC KEY-----", "")
                .replace("-----END PUBLIC KEY-----", "")
                .replaceAll("\\s", "");
        byte[] publicKeyBytes = Base64.decodeBase64(publicKeyPem);
        X509EncodedKeySpec pubKeySpec = new X509EncodedKeySpec(publicKeyBytes);
        idpPublicKey = KeyFactory.getInstance("RSA").generatePublic(pubKeySpec);
    }

    @PostMapping("/saml/SSO")
    public String receiveSamlAssertion(@RequestBody String samlResponse) throws Exception {
        // Decode Base64 SAML response
        byte[] decodedBytes = Base64.decodeBase64(samlResponse);
        String xmlString = new String(decodedBytes, StandardCharsets.UTF_8);

        // Unmarshall XML to EncryptedAssertion
        EncryptedAssertion encryptedAssertion = (EncryptedAssertion) XMLObjectProviderRegistrySupport
                .getUnmarshallerFactory().getUnmarshaller(EncryptedAssertion.DEFAULT_ELEMENT_NAME)
                .unmarshall(XMLObjectProviderRegistrySupport.getParserPool().parse(xmlString));

        // Decrypt the Assertion
        Assertion assertion = AlgorithmSupport.decrypt(encryptedAssertion, decryptionCredential);

        // Validate Signature
        Credential validationCredential = new BasicX509Credential(null);
        validationCredential.setPublicKey(idpPublicKey);
        SignatureValidator.validate(assertion.getSignature(), validationCredential);

        // Extract custom parameter
        String customParam = assertion.getAttributeStatements().get(0)
                .getAttributes().get(0).getAttributeValues().get(0).getTextContent();

        return "Assertion validated. Custom Parameter: " + customParam;
    }
}
